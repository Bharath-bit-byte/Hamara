# =============================================================================
# HamaraShops.ai Frontend Environment Variables Template
# Copy this file to .env (or .env.local) and adjust values for your environment.
# DO NOT commit actual secrets or production keys to version control.
# =============================================================================

# Monolithic Backend Endpoint (Local: http://localhost:8080/api/v1, Production: Cloud Run URL)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Cal.com Scheduling Configuration
# Set your Cal.com username or username/event-slug (e.g., "hamarashops/business-consultation")
VITE_CALCOM_LINK=hamarashops/business-consultation

# Optional: Custom Cal.com origin (Defaults to https://cal.com if unset, or self-hosted Cal.diy URL)
# VITE_CALCOM_ORIGIN=https://cal.com

# Optional: Google AI Studio Gemini API key (if configuring direct client-side Gemini fallback)
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

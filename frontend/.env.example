# =============================================================================
# HamaraShops.ai Frontend Environment Variables Template
# Copy this file to .env (or .env.local) and adjust values for your environment.
# DO NOT commit actual secrets or production keys to version control.
# =============================================================================

# Monolithic Backend Endpoint (Local: http://localhost:8080/api/v1, Production: Cloud Run URL)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Easy!Appointments Booking Portal URL (Leave blank to use direct contact form fallback)
# Example: https://booking.yourdomain.com OR https://easyappointments-xxx.run.app
VITE_BOOKING_URL=https://booking.yourdomain.com

# Optional: Google AI Studio Gemini API key (if configuring direct client-side Gemini fallback)
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

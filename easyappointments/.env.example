# =============================================================================
# HamaraShops.ai - Easy!Appointments Environment Configuration Template
# For Google Cloud Run & Local Development
# =============================================================================

# Application Base URL (No trailing slash)
# Local: http://localhost:8085
# Production: https://booking.yourdomain.com OR https://easyappointments-xxx.run.app
BASE_URL=https://booking.yourdomain.com

# UI Language (e.g. english, french, german, spanish)
LANGUAGE=english

# Debug Mode (FALSE in production; TRUE during troubleshooting)
DEBUG_MODE=FALSE

# Database Configuration (MySQL / Cloud SQL)
# Local Docker: db:3306
# Cloud Run: localhost:/cloudsql/<PROJECT_ID>:<REGION>:<INSTANCE_NAME>
DB_HOST=localhost:/cloudsql/YOUR_PROJECT_ID:asia-south1:YOUR_INSTANCE_NAME
DB_NAME=easyappointments
DB_USERNAME=ea_user
DB_PASSWORD=YOUR_STRONG_SECURE_PASSWORD

# Trusted Reverse Proxy (Use * for Google Cloud Run load balancers)
PROXY_IPS=*

# Email & Notification Settings (Resend SMTP Integration)
MAIL_PROTOCOL=smtp
MAIL_SMTP_HOST=smtp.resend.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=resend
MAIL_SMTP_PASS=YOUR_RESEND_API_KEY
MAIL_SMTP_CRYPTO=tls
MAIL_SMTP_AUTH=1
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME=HamaraShops.ai Business Consultations
MAIL_REPLY_TO_ADDRESS=info@hamarashops.ai
